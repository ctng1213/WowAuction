[
 {"id": "P5", "name": "sale with certain chance refunds the deposit", "call": "expected_post",
  "args": {"p": 1, "qty": 20, "price": 10000, "fallback": 0, "deposit": 1500}, "expect": 190000,
  "why": "20 x 1g x 0.95 = 19g; the 15s deposit is refunded on a sale"},
 {"id": "P9", "name": "half chance mixes the sale with vendor value minus the lost deposit", "call": "expected_post",
  "args": {"p": 0.5, "qty": 20, "price": 10000, "fallback": 500, "deposit": 1500}, "expect": 99250,
  "why": "0.5 x 19g + 0.5 x (20 x 5s - 15s) = 9g 50s + 42s 50c = 9g 92s 50c"},
 {"id": "P15", "name": "full tier history weighs half", "call": "blend",
  "args": {"p_queue": 0.6, "tier_sell_through": 0.8, "tier_n": 30}, "expect": 0.7,
  "why": "e = 0.5 x min(1, 30/30) = 0.5; 0.5 x 0.60 + 0.5 x 0.80 = 0.70"},
 {"id": "P16", "name": "thin tier history weighs less", "call": "blend",
  "args": {"p_queue": 0.6, "tier_sell_through": 0.8, "tier_n": 15}, "expect": 0.65,
  "why": "e = 0.5 x 15/30 = 0.25; 0.75 x 0.60 + 0.25 x 0.80 = 0.65"},
 {"id": "O1", "name": "three expiries pull the model down", "call": "with_record",
  "args": {"p": 0.8, "sold": 0, "expired": 3, "weight": 4}, "expect": 0.45714285714285713,
  "why": "(4 x 0.8 + 0) / (4 + 0 + 3) = 3.2 / 7 = 0.457 -> shown 46%"},
 {"id": "IU5", "name": "curve interpolates between units-ahead points", "call": "from_curve",
  "args": {"row": [1.0, 0.95, 0.9, 0.78, 0.6, 0.4, 0.2, 0.1], "ahead": 3}, "expect": 0.86,
  "why": "between 2 ahead (0.90) and 5 ahead (0.78): 0.90 - 0.12 x 1/3 = 0.86"},
 {"id": "IU8", "name": "the current hour's row is used", "call": "lookup",
  "args": {"refresh_ms": 21600000, "now_ms": 72000000, "ahead": 0, "ahead_points": [0],
           "curve": [[0.40],[0.40],[0.40],[0.40],[0.40],[0.40],[0.40],[0.40],[0.40],[0.40],[0.40],[0.40],
                     [0.40],[0.40],[0.84],[0.40],[0.40],[0.40],[0.40],[0.40],[0.40],[0.40],[0.40],[0.40]]},
  "expect": 0.84,
  "why": "refresh at 06:00, now 20:00: row 14 holds the evening's 0.84, not row 0's 0.40"},
 {"id": "EX19", "name": "a one row curve is used at any hour", "call": "lookup",
  "args": {"refresh_ms": 64800000, "now_ms": 97200000, "ahead": 5, "ahead_points": [0, 5, 20],
           "curve": [[0.9, 0.6, 0.2]]},
  "expect": 0.6,
  "why": "a tooltip-only item keeps only the refresh hour's row (18:00); at 03:00 the next day (row 9 of a full curve) that row still applies: 5 ahead -> 0.6"},
 {"id": "IU9", "name": "after a day the same clock hour's row is reused", "call": "curve_row",
  "args": {"refresh_ms": 21600000, "now_ms": 115200000}, "expect": 2,
  "why": "refresh Fri 06:00, now Sat 08:00 = 26 hours later; 26 mod 24 = row 2, the 08:00 row"},
 {"id": "IU11", "name": "exported probabilities are 2% steps", "call": "quantize",
  "args": {"p": 0.853}, "expect": 43,
  "why": "floor(0.853 x 50 + 0.5) = floor(43.15) = 43 -> 43 / 50 = 0.86, stored as char 35 + 43 = 'N'"},
 {"id": "PD1", "name": "cheaper than the cheapest other listing gets the cheapest default", "call": "default_chance",
  "args": {"price": 49, "cur_others": 50, "default_sell_prob": 0.25, "default_sell_prob_cheapest": 0.5}, "expect": 0.5,
  "why": "volume unknown, 49c <= 50c: you'd be the cheapest -> default_sell_prob_cheapest 0.5"},
 {"id": "PD1", "name": "a tie with the cheapest counts as cheapest", "call": "default_chance",
  "args": {"price": 50, "cur_others": 50, "default_sell_prob": 0.25, "default_sell_prob_cheapest": 0.5}, "expect": 0.5,
  "why": "50c <= 50c"},
 {"id": "PD1", "name": "someone cheaper gets the plain default", "call": "default_chance",
  "args": {"price": 51, "cur_others": 50, "default_sell_prob": 0.25, "default_sell_prob_cheapest": 0.5}, "expect": 0.25,
  "why": "51c > 50c -> default_sell_prob 0.25"},
 {"id": "PD1", "name": "nobody else listing it is the cheapest", "call": "default_chance",
  "args": {"price": 49, "cur_others": null, "default_sell_prob": 0.25, "default_sell_prob_cheapest": 0.5}, "expect": 0.5,
  "why": "no competitor"},
 {"id": "PD1", "name": "an unknown price with nobody else listing it", "call": "default_chance",
  "args": {"price": null, "cur_others": null, "default_sell_prob": 0.25, "default_sell_prob_cheapest": 0.5}, "expect": 0.5,
  "why": "no competitor"}

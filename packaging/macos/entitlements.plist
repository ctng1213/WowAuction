<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for AHSync.app (SPEC §3.7.12, §6 item 21). Python's ctypes and pyobjc
     need unsigned executable memory; disable-library-validation is added only if the first notarized
     run shows it is needed (PyInstaller signs every bundled library with the same identity). -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
